  "$id": "urn:ui-portability:snapshot:1.1.0",
  "title": "UI Portability Snapshot IR 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "kind": {
      "const": "ui-portability-snapshot"
    },
    "capability": {
      "enum": [
        "static",
        "visual-only"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "page",
            "html",
            "svg",
            "json",
            "image"
          ]
        },
        "origin": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "type",
        "origin"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 12000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 12000
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "background": {
      "type": "string",
      "maxLength": 2000
    },
    "tree": {
      "$ref": "#/$defs/node"
    },
    "resources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^r[0-9]+$"
          },
          "mime": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "data": {
            "type": "string",
            "maxLength": 2000000,
            "contentEncoding": "base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "const": "captured"
          }
        },
        "required": [
          "id",
          "mime",
          "data",
          "sha256",
          "status"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "sanitized-dom",
            "local-file",
            "raster-import",
            "migrated-v02"
          ]
        },
        "status": {
          "enum": [
            "captured",
            "external-unverified"
          ]
        }
      },
      "required": [
        "method",
        "status"
      ]
    },
    "omissions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redacted": {
          "type": "boolean"
        },
        "remoteResources": {
          "const": false
        },
        "scripts": {
          "const": false
        }
      },
      "required": [
        "redacted",
        "remoteResources",
        "scripts"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "omittedImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "canvasImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "omittedFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "redactedControls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "externalLinks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "svg": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "behaviors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipe": {
            "enum": [
              "fourier@1",
              "table@1"
            ]
          },
          "bindings": {
            "type": "object",
            "minProperties": 5,
            "maxProperties": 6,
            "additionalProperties": {
              "type": "string",
              "pattern": "^0(?:\\.[0-9]{1,4}){0,75}$"
            }
          },
          "state": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "harmonics": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "amplitude": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1.5
                  },
                  "phase": {
                    "type": "number",
                    "minimum": -3.14,
                    "maximum": 3.14
                  }
                },
                "required": [
                  "harmonics",
                  "amplitude",
                  "phase"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 50
                  },
                  "direction": {
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "minimum",
                  "direction"
                ]
              }
            ]
          },
          "evidence": {
            "const": "fixture-equivalence-v1"
          }
        },
        "required": [
          "recipe",
          "bindings",
          "state",
          "evidence"
        ]
      }
    }
